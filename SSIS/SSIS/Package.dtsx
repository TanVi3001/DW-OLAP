          SQLTask:SqlStatementSource="-- 1. Xóa bảng FACT trước (vì nó chứa FK trỏ đến các bảng chiều)&#xA;TRUNCATE TABLE [dbo].[FACT_ACCIDENT];&#xA;&#xA;-- 2. Sau đó mới xóa các bảng chiều&#xA;DELETE FROM [dbo].[DIM_WEATHER];&#xA;DELETE FROM [dbo].[DIM_SEVERITY];&#xA;DELETE FROM [dbo].[DIM_TRAFFIC_SIGNAL];&#xA;DELETE FROM [dbo].[DIM_ROAD_STRUCTURE];&#xA;DELETE FROM [dbo].[DIM_LOCATION];&#xA;DELETE FROM [dbo].[DIM_TIME];&#xA;DELETE FROM [dbo].[DIM_DATE];&#xA;&#xA;-- 3. Reset cột ID tự tăng về lại số 1 ban đầu&#xA;DBCC CHECKIDENT ('[dbo].[DIM_LOCATION]', RESEED, 0);&#xA;DBCC CHECKIDENT ('[dbo].[DIM_ROAD_STRUCTURE]', RESEED, 0);&#xA;DBCC CHECKIDENT ('[dbo].[DIM_TRAFFIC_SIGNAL]', RESEED, 0);&#xA;DBCC CHECKIDENT ('[dbo].[DIM_WEATHER]', RESEED, 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
