  <Source dwd:design-time-name="36c45d38-d7bc-4e69-81b0-778382865d9f">
    <DataSourceViewID>US Accidents DW</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="5449776a-7711-49a2-987c-bcb597cb232b">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CALCULATE; 

CREATE MEMBER CURRENTCUBE.[Measures].[Fog_Accident_Rate]
AS IIF(
    ([Measures].[FACT ACCIDENT Count], [DIM WEATHER].[WEATHER CONDITION].[All]) = 0,
    NULL,
    Round(
        Aggregate(
            Filter(
                [DIM WEATHER].[WEATHER CONDITION].[WEATHER CONDITION].Members,
                InStr([DIM WEATHER].[WEATHER CONDITION].CurrentMember.Name, "Fog") &gt; 0
            ),
            [Measures].[FACT ACCIDENT Count]
        ) / ([Measures].[FACT ACCIDENT Count], [DIM WEATHER].[WEATHER CONDITION].[All]),
        4
    )
), 
FORMAT_STRING = "Percent", 
VISIBLE = 1; 

CREATE DYNAMIC SET CURRENTCUBE.[States_Fog_Rate_Over_5Pct]
AS Order(
    Filter(
        NonEmpty(
            [DIM LOCATION].[STATE].[STATE].Members,
            ([Measures].[FACT ACCIDENT Count], [ID START DATE].[YEAR].&amp;[2022])
        ),
        [Measures].[Fog_Accident_Rate] &gt; 0.05
    ),
    [Measures].[Fog_Accident_Rate],
    BDESC
); 

CREATE SET CURRENTCUBE.[Top5_CA_Street_City_Night_Signal]
AS TopCount(
    Order(
        NonEmpty(
            Exists(
                [DIM LOCATION].[STREET].[STREET].Members,
                [DIM LOCATION].[STATE].&amp;[CA]
            ),
            (
                [Measures].[FACT ACCIDENT Count],
                [FACT ACCIDENT].[SUNRISE SUNSET].&amp;[Night],
                [DIM TRAFFIC SIGNAL].[TRAFFIC SIGNAL].&amp;[True]
            )
        ),
        (
            [Measures].[FACT ACCIDENT Count],
            [FACT ACCIDENT].[SUNRISE SUNSET].&amp;[Night],
            [DIM TRAFFIC SIGNAL].[TRAFFIC SIGNAL].&amp;[True]
        ),
        BDESC
    ),
    5,
    (
        [Measures].[FACT ACCIDENT Count],
        [FACT ACCIDENT].[SUNRISE SUNSET].&amp;[Night],
        [DIM TRAFFIC SIGNAL].[TRAFFIC SIGNAL].&amp;[True]
    )
); 

CREATE MEMBER CURRENTCUBE.[Measures].[YoY_Growth_Rate]
AS IIF(
    IsEmpty((ParallelPeriod([ID START DATE].[Hierarchy].[YEAR], 1, [ID START DATE].[Hierarchy].CurrentMember), [Measures].[FACT ACCIDENT Count]))
    OR (ParallelPeriod([ID START DATE].[Hierarchy].[YEAR], 1, [ID START DATE].[Hierarchy].CurrentMember), [Measures].[FACT ACCIDENT Count]) = 0,
    NULL,
    (
        [Measures].[FACT ACCIDENT Count] 
        - (ParallelPeriod([ID START DATE].[Hierarchy].[YEAR], 1, [ID START DATE].[Hierarchy].CurrentMember), [Measures].[FACT ACCIDENT Count])
    ) / (ParallelPeriod([ID START DATE].[Hierarchy].[YEAR], 1, [ID START DATE].[Hierarchy].CurrentMember), [Measures].[FACT ACCIDENT Count])
), 
FORMAT_STRING = "Percent", 
VISIBLE = 1; 

-- ❌ XÓA DÒNG NÀY:
-- CREATE MEMBER CURRENTCUBE.[Measures].[Calculated Member]
-- AS , 
-- VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Average_Distance]
AS IIF([Measures].[FACT ACCIDENT Count] = 0, NULL, Round([Measures].[DISTANCE] / [Measures].[FACT ACCIDENT Count], 2)), 
FORMAT_STRING = "Standard", 
VISIBLE = 1; 
CREATE MEMBER CURRENTCUBE.[Measures].[Severity_3_4_Rate]
 AS IIF(
    ([Measures].[FACT ACCIDENT Count], [DIM SEVERITY].[ID SEVERITY].[All]) = 0,
    NULL,
    (
        ([Measures].[FACT ACCIDENT Count], [DIM SEVERITY].[ID SEVERITY].&amp;[3])
        + ([Measures].[FACT ACCIDENT Count], [DIM SEVERITY].[ID SEVERITY].&amp;[4])
    ) / ([Measures].[FACT ACCIDENT Count], [DIM SEVERITY].[ID SEVERITY].[All])
), 
FORMAT_STRING = "Percent", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Night_Accident_Rate]
 AS IIF(
    ([Measures].[FACT ACCIDENT Count], [FACT ACCIDENT].[SUNRISE SUNSET].[All]) = 0,
    NULL,
    (
        [Measures].[FACT ACCIDENT Count],
        [FACT ACCIDENT].[SUNRISE SUNSET].&amp;[Night]
    ) / ([Measures].[FACT ACCIDENT Count], [FACT ACCIDENT].[SUNRISE SUNSET].[All])
), 
FORMAT_STRING = "Percent", 
VISIBLE = 1  ; 

CREATE DYNAMIC SET CURRENTCUBE.[TX_Cities_Over_1000]
AS Order(
    Filter(
        Exists([DIM LOCATION].[CITY].[CITY].Members, [DIM LOCATION].[STATE].&amp;[TX]),
        [Measures].[FACT ACCIDENT Count] &gt; 1000
    ),
    [Measures].[FACT ACCIDENT Count],
    BDESC
); 

CREATE MEMBER CURRENTCUBE.[Measures].[US_Junction]
AS ([Measures].[FACT ACCIDENT Count], [DIM ROAD STRUCTURE].[JUNCTION].&amp;[True]), 
VISIBLE = 1; 

CREATE MEMBER CURRENTCUBE.[Measures].[CA_Junction]
AS ([Measures].[FACT ACCIDENT Count], [DIM LOCATION].[STATE].&amp;[CA], [DIM ROAD STRUCTURE].[JUNCTION].&amp;[True]), 
FORMAT_STRING = "Standard", 
VISIBLE = 1; 

CREATE MEMBER CURRENTCUBE.[Measures].[CA_Roundabout]
AS ([Measures].[FACT ACCIDENT Count], [DIM LOCATION].[STATE].&amp;[CA], [DIM ROAD STRUCTURE].[ROUNDABOUT].&amp;[True]), 
VISIBLE = 1; 

CREATE MEMBER CURRENTCUBE.[Measures].[US_Roundabout]
AS ([Measures].[FACT ACCIDENT Count], [DIM ROAD STRUCTURE].[ROUNDABOUT].&amp;[True]), 
VISIBLE = 1; 

CREATE MEMBER CURRENTCUBE.[Measures].[US_Railway]
AS ([Measures].[FACT ACCIDENT Count], [DIM ROAD STRUCTURE].[RAILWAY].&amp;[True]), 
VISIBLE = 1; 

CREATE MEMBER CURRENTCUBE.[Measures].[CA_Railway]
AS ([Measures].[FACT ACCIDENT Count], [DIM LOCATION].[STATE].&amp;[CA], [DIM ROAD STRUCTURE].[RAILWAY].&amp;[True]), 
VISIBLE = 1; 

CREATE MEMBER CURRENTCUBE.[Measures].[US_Traffic_Signal]
AS ([Measures].[FACT ACCIDENT Count], [DIM TRAFFIC SIGNAL].[TRAFFIC SIGNAL].&amp;[True]), 
VISIBLE = 1; 

CREATE MEMBER CURRENTCUBE.[Measures].[CA_Traffic_Signal]
AS ([Measures].[FACT ACCIDENT Count], [DIM LOCATION].[STATE].&amp;[CA], [DIM TRAFFIC SIGNAL].[TRAFFIC SIGNAL].&amp;[True]), 
VISIBLE = 1; 

CREATE DYNAMIC SET CURRENTCUBE.[Top_City_Severity4_Year2021]
AS TopCount(
    NonEmpty(
        [DIM LOCATION].[CITY].[CITY].Members,
        ([Measures].[FACT ACCIDENT Count], [DIM SEVERITY].[ID SEVERITY].&amp;[4], [ID START DATE].[YEAR].&amp;[2021])
    ),
    1,
    ([Measures].[FACT ACCIDENT Count], [DIM SEVERITY].[ID SEVERITY].&amp;[4], [ID START DATE].[YEAR].&amp;[2021])
); </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>